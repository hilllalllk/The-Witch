    public IEnumerator spawnObject() 

  

    { 

        while (!cadıscript.isdead) 

        { 

            Instantiate(borular, new Vector3(3, Random.Range(-height, height), 0), Quaternion.identity); 

            yield return new WaitForSeconds(2.3f); 

            

        } 

        

  

    } 

    public IEnumerator bombObject() 

    { 

        while (!cadıscript.isdead) 

        { 

  

            Instantiate(bomb, new Vector3(6, Random.Range(-yüksek, yüksek), 0), Quaternion.identity); 

