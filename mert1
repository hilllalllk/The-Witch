    private void OnTriggerEnter2D(Collider2D collision)
    {
        if (collision.gameObject.transform.tag == "düşman")
        {
            Destroy(collision.gameObject);
            puan++;
            puantext.text = "" + puan;
        }
        if (collision.gameObject.transform.tag == "anadüşman")
        {

            Destroy(this.gameObject);
            oyunbitti = true;

        }
        if (collision.gameObject.transform.tag == "babadüşman")
        {
            GetComponent<AudioSource>().PlayOneShot(bomba, 1f);
            Destroy(this.gameObject);
            oyunbitti = true;

        }
        if (oyunbitti == true)
        {
            dead();

            //SceneManager.LoadScene(0);
        }
        if (collision.gameObject.transform.tag == "dost")
        {
            GetComponent<AudioSource>().PlayOneShot(yıldız, 1f);
            Destroy(collision.gameObject);
            puan = puan + 5;
            puantext.text = "" + puan;
        }
        if (collision.gameObject.transform.tag == "sinsi")
        {
            GetComponent<AudioSource>().PlayOneShot(hayalet, 1f);
            Destroy(collision.gameObject);
            velocity = velocity + (-1f);
            puan = puan - 10;
            puantext.text = "" + puan;
        }
        if (collision.gameObject.transform.tag == "şans")
        {
            GetComponent<AudioSource>().PlayOneShot(ruh, 1f);
            Destroy(collision.gameObject);
            velocity = velocity + (0.5f);
            puan = puan + 10;
            puantext.text = "" + puan;
        }
        if (highscore < puan)
        {
            PlayerPrefs.SetInt("High Score", puan);
        }
    }
    public void dead()
    {
        öldünpanel.SetActive(true);
        pause.SetActive(false);
        Time.timeScale = 0f;

    }

