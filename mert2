using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.UI;
using UnityEngine.SceneManagement;
using TMPro;

public class scoreManager : MonoBehaviour
{
    public Text scoreText;
    public Text highScoreText;

    void Start()
    {

    }


    private void Update()
    {

        scoreText.text = "Your Score " + cadı.puan.ToString();
        cadı.highscore = PlayerPrefs.GetInt("High Score");
        highScoreText.text = "High Score " + cadı.highscore;
    }
    public void Score()
    {
        SceneManager.LoadScene(1);
        int puanPoints = cadı.puan;
        scoreText.text = puanPoints.ToString();

    }
}